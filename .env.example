# PostgreSQL (use sslmode=require for managed production databases)
DATABASE_URL=postgresql://user:password@host:5432/afm?sslmode=require

# Generate with: openssl rand -base64 32
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_URL=http://localhost:3000

# Cloudflare R2 S3-compatible API
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=afm-media
R2_PUBLIC_BASE_URL=https://media.example.com
# Separate from SESSION_SECRET; generate with: openssl rand -base64 32
UPLOAD_TICKET_SECRET=replace-with-a-different-32-character-secret

# Exact comma-separated browser origins allowed to request upload URLs
ALLOWED_ORIGINS=http://localhost:3000

# Dev only: store uploads on local disk (public/uploads) instead of R2
# STORAGE_DRIVER=local
